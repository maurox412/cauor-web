# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
DATABASE_URL="postgresql://cauor:cauor_dev@localhost:5432/cauor?schema=public"
# Genera uno con: openssl rand -base64 48
SESSION_SECRET=""
# Carpeta PRIVADA (fuera de /public) donde se guardan los comprobantes
STORAGE_DIR="./storage"
# Usuario administrador inicial (solo para el seed)
SEED_ADMIN_USER="admin"
SEED_ADMIN_CLAVE=""
